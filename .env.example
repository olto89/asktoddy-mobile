# Example environment file - Copy to .env and add your actual values
# NEVER commit .env files with real keys to git!

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API - Get from https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# App Configuration
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_API_URL=your_api_url_here
EXPO_PUBLIC_ENABLE_MOCK_DATA=false
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=true
