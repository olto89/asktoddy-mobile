{
  "name": "asktoddy-mobile",
  "version": "1.2.4",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "context:save": "node scripts/save-context.js",
    "context:linear": "node scripts/sync-linear-api.js",
    "context:sync": "npm run context:save && npm run context:linear",
    "claude:resume": "cat .claude-context/current-session.json",
    "linear:webhook": "node scripts/linear-webhook-server.js",
    "linear:sync": "npm run context:linear",
    "docs:update": "node scripts/update-documentation.js",
    "git:checkpoint": "node scripts/git-checkpoint.js",
    "git:checkpoint:push": "node scripts/git-checkpoint.js --push",
    "session:start": "npm run context:sync && npm run docs:update",
    "session:end": "npm run context:sync && npm run docs:update && npm run git:checkpoint session-end",
    "session:milestone": "npm run git:checkpoint milestone --push",
    "setup:hooks": "node scripts/setup-git-hooks.js",
    "setup:complete": "npm run setup:hooks && npm run session:start",
    "linear:create-tickets": "node scripts/create-linear-tickets.js",
    "deploy:testflight": "./scripts/deploy-testflight.sh",
    "deploy:staging": "node scripts/deploy-edge-functions.js staging",
    "deploy:production": "node scripts/deploy-edge-functions.js production",
    "supabase:validate": "node scripts/validate-edge-functions.js",
    "supabase:serve": "supabase functions serve --no-verify-jwt",
    "supabase:test": "npm run supabase:validate && echo 'Install Docker Desktop to run: npm run supabase:serve'",
    "supabase:lines": "wc -l supabase/functions/analyze-construction/*.ts supabase/functions/analyze-construction/providers/*.ts",
    "build:staging": "eas build --profile staging --platform ios",
    "build:production": "eas build --profile production --platform ios",
    "submit:testflight": "eas submit --profile staging --platform ios",
    "submit:appstore": "eas submit --profile production --platform ios",
    "env:use": "node scripts/switch-environment.js",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "quality": "npm run type-check && npm run lint:check && npm run format:check",
    "prepare": "husky",
    "pricing:process": "npx tsx scripts/process-price-pdfs.ts",
    "pricing:populate": "npx tsx scripts/populate-sample-data.ts",
    "pricing:migrate": "supabase migration up --local",
    "pricing:setup": "npm run pricing:migrate && npm run pricing:populate",
    "pricing:merchants": "npx tsx scripts/process-merchants-pricing.ts",
    "pricing:hybrid": "npx tsx scripts/hybrid-pricing-pipeline.ts",
    "pricing:scrape": "npx tsx scripts/scrape-building-materials.ts",
    "poc:start": "node quote-accuracy-server-v2.js",
    "poc:test": "node test-quote-poc-secure.js",
    "pricing:aggregates": "npx tsx scripts/scrape-aggregates-suppliers.ts",
    "pricing:master": "npx tsx scripts/master-price-aggregator.ts",
    "pricing:buymaterials": "npx tsx scripts/scrape-buymaterials.ts",
    "pricing:comprehensive": "npx tsx scripts/scrape-buymaterials-comprehensive.ts",
    "pricing:all-suppliers": "npx tsx scripts/scrape-comprehensive-suppliers.ts",
    "pricing:plumb-build": "npx tsx scripts/scrape-plumb-build.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@google/generative-ai": "^0.24.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.4.10",
    "@supabase/supabase-js": "^2.75.0",
    "base64-arraybuffer": "^1.0.2",
    "cors": "^2.8.5",
    "expo": "~54.0.30",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "^6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "pdf-extraction": "^1.0.2",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "puppeteer": "^24.29.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-purchases": "^9.6.15",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^55.0.11",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "lint-staged": "^16.2.5",
    "node-fetch": "^2.7.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
